# Copy to .env and fill in. .env is gitignored.

# --- EDGAR ---------------------------------------------------------------
# REQUIRED. The SEC returns 403 without a descriptive User-Agent containing
# a real email address. Format: "Name email@example.com"
EDGAR_USER_AGENT="Your Name your.email@example.com"
EDGAR_REQUESTS_PER_SECOND=8.0

# --- Storage -------------------------------------------------------------
# "local" writes under ./data. Switch to "s3" and set S3_BUCKET for AWS.
STORAGE_BACKEND=local
# S3_BUCKET=my-edgar-rag-bucket
# S3_PREFIX=edgar
# AWS_REGION=us-east-1

# --- Embeddings ----------------------------------------------------------
# Runs locally, no API cost. Dim must match the model.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Index / retrieval ---------------------------------------------------
FAISS_INDEX_TYPE=flat        # "flat" while developing, "ivf" at 10K+ docs
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20

# --- Generation ----------------------------------------------------------
LLM_PROVIDER=anthropic       # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Database ------------------------------------------------------------
# Matches docker-compose.yml. Use host "db" from inside the app container.
DATABASE_URL=postgresql+psycopg://edgar:edgar@localhost:5432/edgar_rag

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
